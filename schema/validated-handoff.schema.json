{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/validated-handoff.schema.json",
  "title": "CrossTrace validated handoff",
  "description": "Serializable audit form of the common SL, CR, and PR validation result. Arrays labelled sorted are required to be lexicographically sorted by the executable normaliser; JSON Schema cannot express that ordering or uniqueness projected solely by nested source_deliveries.message_id, so the Python decoder enforces both invariants. The process-local policy-admission tag is intentionally not serialized; decoded objects must be revalidated before policy use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "validated_handoff_id",
    "representation",
    "neutral_handoff_id",
    "handoff",
    "sender_authenticated",
    "receiver_authenticated",
    "bilateral_agreement",
    "parent_relation_valid",
    "conflict_free",
    "receiver_decision",
    "receiver_decided_at",
    "delivered_holder_principal_ids",
    "source_record_ids",
    "source_message_ids",
    "source_deliveries",
    "validation_reasons",
    "binding_facts"
  ],
  "properties": {
    "version": { "const": "crosstrace-validation/0.1" },
    "validated_handoff_id": { "$ref": "#/$defs/sha256" },
    "representation": { "enum": ["SL", "CR", "PR"] },
    "neutral_handoff_id": { "$ref": "#/$defs/sha256" },
    "handoff": { "$ref": "#/$defs/neutralHandoff" },
    "sender_authenticated": { "const": true },
    "receiver_authenticated": { "const": true },
    "bilateral_agreement": { "type": "boolean" },
    "parent_relation_valid": { "const": true },
    "conflict_free": { "const": true },
    "receiver_decision": { "enum": ["ACCEPT", "REJECT"] },
    "receiver_decided_at": { "$ref": "#/$defs/timestamp" },
    "delivered_holder_principal_ids": {
      "type": "array",
      "description": "Lexicographically sorted unique principal identifiers for holders whose delivered copies contributed to this result.",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "source_record_ids": {
      "type": "array",
      "description": "Lexicographically sorted unique record identifiers used by validation.",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "source_message_ids": {
      "type": "array",
      "description": "Lexicographically sorted unique transport-message identifiers used by validation.",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "source_deliveries": {
      "type": "array",
      "description": "Unique delivery provenance sorted by message_id, delivery_slot_id, origin_store_id, holder_principal_id, holder_role, then source_record_id.",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceDelivery" }
    },
    "validation_reasons": {
      "type": "array",
      "description": "Lexicographically sorted unique stable reason codes. An empty array denotes no validation failure.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "binding_facts": { "$ref": "#/$defs/bindingFacts" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "receiver_decision": { "const": "ACCEPT" } },
        "required": ["receiver_decision"]
      },
      "then": {
        "properties": {
          "bilateral_agreement": { "const": true },
          "validation_reasons": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "bilateral_agreement": { "const": false },
          "validation_reasons": { "const": ["RECEIVER_REJECTED"] }
        }
      }
    },
    {
      "if": {
        "properties": { "representation": { "const": "SL" } },
        "required": ["representation"]
      },
      "then": {
        "properties": {
          "source_record_ids": { "minItems": 2, "maxItems": 2 },
          "source_deliveries": {
            "allOf": [
              {
                "contains": {
                  "properties": { "holder_role": { "const": "SENDER" } },
                  "required": ["holder_role"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": { "holder_role": { "const": "RECEIVER" } },
                  "required": ["holder_role"]
                },
                "minContains": 1
              }
            ]
          },
          "binding_facts": { "$ref": "#/$defs/slBindingFacts" }
        }
      }
    },
    {
      "if": {
        "properties": { "representation": { "const": "CR" } },
        "required": ["representation"]
      },
      "then": {
        "properties": {
          "source_record_ids": { "minItems": 2, "maxItems": 2 },
          "source_deliveries": {
            "allOf": [
              {
                "contains": {
                  "properties": { "holder_role": { "const": "SENDER" } },
                  "required": ["holder_role"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": { "holder_role": { "const": "RECEIVER" } },
                  "required": ["holder_role"]
                },
                "minContains": 1
              }
            ]
          },
          "binding_facts": { "$ref": "#/$defs/crBindingFacts" }
        }
      }
    },
    {
      "if": {
        "properties": { "representation": { "const": "PR" } },
        "required": ["representation"]
      },
      "then": {
        "properties": {
          "source_record_ids": { "minItems": 1, "maxItems": 1 },
          "binding_facts": { "$ref": "#/$defs/prBindingFacts" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "agent_id", "key_id"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/identifier" },
        "agent_id": { "$ref": "#/$defs/identifier" },
        "key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "paymentV1Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "resources",
        "currency",
        "max_amount_minor",
        "not_before",
        "not_after",
        "redelegations_remaining"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": { "$ref": "#/$defs/timestamp" },
        "redelegations_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "authorityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_principal_id",
        "subject_principal_id",
        "subject_key_id"
      ],
      "properties": {
        "issuer_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "neutralHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "sender",
        "receiver",
        "event_type",
        "sender_sequence",
        "previous_interaction_id",
        "scope",
        "authority_lineage",
        "authority_version",
        "referenced_status_id",
        "created_at",
        "request_hash"
      ],
      "properties": {
        "interaction_id": { "$ref": "#/$defs/identifier" },
        "sender": { "$ref": "#/$defs/party" },
        "receiver": { "$ref": "#/$defs/party" },
        "event_type": { "enum": ["delegation", "action_intent"] },
        "sender_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous_interaction_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "scope": { "$ref": "#/$defs/paymentV1Scope" },
        "authority_lineage": { "$ref": "#/$defs/authorityLineage" },
        "authority_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "referenced_status_id": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "request_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "delivery_slot_id",
        "origin_store_id",
        "holder_principal_id",
        "holder_role",
        "source_record_id"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/sha256" },
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "origin_store_id": { "$ref": "#/$defs/identifier" },
        "holder_principal_id": { "$ref": "#/$defs/identifier" },
        "holder_role": { "enum": ["SENDER", "RECEIVER"] },
        "source_record_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "slBindingFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_type",
        "sender_body_id",
        "receiver_body_id",
        "receiver_binds_sender_record",
        "parent_reference_type",
        "encoded_parent_reference"
      ],
      "properties": {
        "binding_type": { "const": "INDEPENDENT_ENDPOINT_SIGNATURES" },
        "sender_body_id": { "$ref": "#/$defs/sha256" },
        "receiver_body_id": { "$ref": "#/$defs/sha256" },
        "receiver_binds_sender_record": { "const": false },
        "parent_reference_type": { "const": "SEMANTIC_INTERACTION_ID" },
        "encoded_parent_reference": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "crBindingFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_type",
        "sender_body_id",
        "receiver_body_id",
        "receiver_binds_sender_record",
        "receiver_bound_sender_record_id",
        "parent_reference_type",
        "encoded_parent_reference"
      ],
      "properties": {
        "binding_type": { "const": "CROSS_REFERENCED_ENDPOINT_SIGNATURES" },
        "sender_body_id": { "$ref": "#/$defs/sha256" },
        "receiver_body_id": { "$ref": "#/$defs/sha256" },
        "receiver_binds_sender_record": { "const": true },
        "receiver_bound_sender_record_id": { "$ref": "#/$defs/sha256" },
        "parent_reference_type": { "const": "SEMANTIC_INTERACTION_ID" },
        "encoded_parent_reference": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "prBindingFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_type",
        "proposal_hash",
        "nested_sender_attestation_bound",
        "parent_reference_type",
        "encoded_parent_reference",
        "resolved_parent_receipt_id"
      ],
      "properties": {
        "binding_type": { "const": "NESTED_DUAL_ATTESTATION" },
        "proposal_hash": { "$ref": "#/$defs/sha256" },
        "nested_sender_attestation_bound": { "const": true },
        "parent_reference_type": { "const": "COMPLETED_RECEIPT_ID" },
        "encoded_parent_reference": { "$ref": "#/$defs/nullableSha256" },
        "resolved_parent_receipt_id": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "bindingFacts": {
      "oneOf": [
        { "$ref": "#/$defs/slBindingFacts" },
        { "$ref": "#/$defs/crBindingFacts" },
        { "$ref": "#/$defs/prBindingFacts" }
      ]
    }
  }
}
