{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/authority-status.schema.json",
  "title": "CrossTrace sketch signed authority status",
  "description": "A locally checked authority freshness and revocation statement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status_id", "status", "attestation"],
  "properties": {
    "status_id": { "$ref": "#/$defs/sha256" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "issuer_principal_id",
        "issuer_key_id",
        "subject_principal_id",
        "subject_key_id",
        "authority_version",
        "state",
        "issued_at",
        "fresh_until"
      ],
      "properties": {
        "protocol_version": { "const": "crosstrace-sketch/0.1" },
        "type": { "const": "authority_status" },
        "issuer_principal_id": { "$ref": "#/$defs/identifier" },
        "issuer_key_id": { "$ref": "#/$defs/identifier" },
        "subject_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_key_id": { "$ref": "#/$defs/identifier" },
        "authority_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": { "enum": ["ACTIVE", "REVOKED"] },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "fresh_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "status_id", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "status_id": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
