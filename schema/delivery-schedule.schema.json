{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/K9-glitch3/crosstrace-protocol-sketch/schema/delivery-schedule.schema.json",
  "title": "CrossTrace Sprint 1 evaluator-side delivery schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "seed_b64",
    "policy",
    "messages",
    "overrides",
    "transmissions"
  ],
  "properties": {
    "version": { "const": "crosstrace-delivery/0.1" },
    "seed_b64": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "policy": { "$ref": "#/$defs/policy" },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" },
      "uniqueItems": true
    },
    "overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/override" },
      "uniqueItems": true
    },
    "transmissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transmission" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "payloadKind": {
      "enum": [
        "AUTHORITY_STATUS",
        "RECEIPT",
        "SIGNED_ENDPOINT_RECORD",
        "CROSS_REFERENCED_RECORD",
        "PROTOCOL_SIGNAL"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "message_id",
        "delivery_slot_id",
        "origin_store_id",
        "destination_store_id",
        "sent_at",
        "payload_kind",
        "payload_hash",
        "payload_b64",
        "payload_size_bytes"
      ],
      "properties": {
        "version": { "const": "crosstrace-delivery/0.1" },
        "message_id": { "$ref": "#/$defs/hash" },
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "origin_store_id": { "$ref": "#/$defs/identifier" },
        "destination_store_id": { "$ref": "#/$defs/identifier" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "payload_kind": { "$ref": "#/$defs/payloadKind" },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "payload_b64": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "payload_size_bytes": { "type": "integer", "minimum": 2 }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_id",
        "origin_store_id",
        "destination_store_id",
        "starts_at",
        "ends_at",
        "behaviour"
      ],
      "properties": {
        "partition_id": { "$ref": "#/$defs/identifier" },
        "origin_store_id": { "$ref": "#/$defs/identifier" },
        "destination_store_id": { "$ref": "#/$defs/identifier" },
        "starts_at": { "$ref": "#/$defs/timestamp" },
        "ends_at": { "$ref": "#/$defs/timestamp" },
        "behaviour": { "const": "BUFFER_UNTIL_END" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_delay_seconds",
        "max_delay_seconds",
        "loss_rate_ppm",
        "duplicate_rate_ppm",
        "partitions",
        "withheld_delivery_slot_ids"
      ],
      "properties": {
        "min_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "max_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "loss_rate_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "duplicate_rate_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "partitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/partition" },
          "uniqueItems": true
        },
        "withheld_delivery_slot_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_slot_id", "copy_index", "disposition", "delay_seconds"],
      "properties": {
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "copy_index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "disposition": { "enum": ["DELIVER", "LOST", "WITHHELD"] },
        "delay_seconds": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 31536000 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "DELIVER" } },
            "required": ["disposition"]
          },
          "then": {},
          "else": {
            "properties": { "delay_seconds": { "type": "null" } }
          }
        }
      ]
    },
    "transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transmission_id",
        "delivery_slot_id",
        "message_id",
        "copy_index",
        "disposition",
        "delivered_at",
        "fault_tags"
      ],
      "properties": {
        "transmission_id": { "$ref": "#/$defs/hash" },
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "message_id": { "$ref": "#/$defs/hash" },
        "copy_index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "disposition": { "enum": ["DELIVER", "LOST", "WITHHELD"] },
        "delivered_at": {
          "anyOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "fault_tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "DELIVER" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "delivered_at": { "$ref": "#/$defs/timestamp" } }
          },
          "else": {
            "properties": { "delivered_at": { "type": "null" } }
          }
        }
      ]
    }
  }
}
