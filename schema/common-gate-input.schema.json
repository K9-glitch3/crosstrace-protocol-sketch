{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/common-gate-input.schema.json",
  "title": "CrossTrace representation-blind common gate input",
  "description": "Audit form only. The process-local preparation tag is intentionally absent, so a decoded object must be prepared again before policy use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "input_id",
    "verifier_id",
    "evidence_store_id",
    "permit_store_id",
    "decision_time",
    "policy_views",
    "authority_status_evidence",
    "permit_state",
    "preparation_reasons"
  ],
  "properties": {
    "version": { "const": "crosstrace-common-gate-input/0.1" },
    "input_id": { "$ref": "#/$defs/sha256" },
    "verifier_id": { "$ref": "#/$defs/identifier" },
    "evidence_store_id": { "$ref": "#/$defs/identifier" },
    "permit_store_id": { "$ref": "#/$defs/identifier" },
    "decision_time": { "$ref": "#/$defs/timestamp" },
    "policy_views": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/policyView" }
    },
    "authority_status_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/statusEvidence" }
    },
    "permit_state": { "$ref": "#/$defs/permitState" },
    "preparation_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "agent_id", "key_id"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/identifier" },
        "agent_id": { "$ref": "#/$defs/identifier" },
        "key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "paymentV1Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "resources",
        "currency",
        "max_amount_minor",
        "not_before",
        "not_after",
        "redelegations_remaining"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": { "$ref": "#/$defs/timestamp" },
        "redelegations_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "authorityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_principal_id",
        "subject_principal_id",
        "subject_key_id"
      ],
      "properties": {
        "issuer_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "neutralHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "sender",
        "receiver",
        "event_type",
        "sender_sequence",
        "previous_interaction_id",
        "scope",
        "authority_lineage",
        "authority_version",
        "referenced_status_id",
        "created_at",
        "request_hash"
      ],
      "properties": {
        "interaction_id": { "$ref": "#/$defs/identifier" },
        "sender": { "$ref": "#/$defs/party" },
        "receiver": { "$ref": "#/$defs/party" },
        "event_type": { "enum": ["delegation", "action_intent"] },
        "sender_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous_interaction_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "scope": { "$ref": "#/$defs/paymentV1Scope" },
        "authority_lineage": { "$ref": "#/$defs/authorityLineage" },
        "authority_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "referenced_status_id": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "request_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "policyView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "neutral_handoff_id",
        "handoff",
        "sender_authenticated",
        "receiver_authenticated",
        "bilateral_agreement",
        "receiver_decision",
        "receiver_decided_at",
        "parent_relation_valid",
        "conflict_free"
      ],
      "properties": {
        "version": { "const": "crosstrace-policy-view/0.1" },
        "neutral_handoff_id": { "$ref": "#/$defs/sha256" },
        "handoff": { "$ref": "#/$defs/neutralHandoff" },
        "sender_authenticated": { "const": true },
        "receiver_authenticated": { "const": true },
        "bilateral_agreement": { "type": "boolean" },
        "receiver_decision": { "enum": ["ACCEPT", "REJECT"] },
        "receiver_decided_at": { "$ref": "#/$defs/timestamp" },
        "parent_relation_valid": { "const": true },
        "conflict_free": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "receiver_decision": { "const": "ACCEPT" } },
            "required": ["receiver_decision"]
          },
          "then": {
            "properties": { "bilateral_agreement": { "const": true } }
          },
          "else": {
            "properties": { "bilateral_agreement": { "const": false } }
          }
        }
      ]
    },
    "statusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "issuer_principal_id",
        "issuer_key_id",
        "subject_principal_id",
        "subject_key_id",
        "authority_version",
        "state",
        "issued_at",
        "fresh_until"
      ],
      "properties": {
        "protocol_version": { "const": "crosstrace-sketch/0.1" },
        "type": { "const": "authority_status" },
        "issuer_principal_id": { "$ref": "#/$defs/identifier" },
        "issuer_key_id": { "$ref": "#/$defs/identifier" },
        "subject_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_key_id": { "$ref": "#/$defs/identifier" },
        "authority_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": { "enum": ["ACTIVE", "REVOKED"] },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "fresh_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_id", "status", "attestation"],
      "properties": {
        "status_id": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/statusPayload" },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "status_id", "signature"],
          "properties": {
            "algorithm": { "const": "Ed25519" },
            "key_id": { "$ref": "#/$defs/identifier" },
            "status_id": { "$ref": "#/$defs/sha256" },
            "signature": { "$ref": "#/$defs/signature" }
          }
        }
      }
    },
    "statusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "delivery_slot_id",
        "origin_store_id",
        "status_id",
        "signed_status"
      ],
      "properties": {
        "message_id": { "$ref": "#/$defs/sha256" },
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "origin_store_id": { "$ref": "#/$defs/identifier" },
        "status_id": { "$ref": "#/$defs/sha256" },
        "signed_status": { "$ref": "#/$defs/signedStatus" }
      }
    },
    "permitRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "leaf_neutral_handoff_id",
        "neutral_chain_id",
        "controlling_status_id",
        "replay_scope_id",
        "request_hash",
        "action_nonce",
        "tool_id",
        "state",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "permit_id": { "$ref": "#/$defs/identifier" },
        "leaf_neutral_handoff_id": { "$ref": "#/$defs/sha256" },
        "neutral_chain_id": { "$ref": "#/$defs/sha256" },
        "controlling_status_id": { "$ref": "#/$defs/sha256" },
        "replay_scope_id": { "$ref": "#/$defs/sha256" },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "action_nonce": { "$ref": "#/$defs/identifier" },
        "tool_id": { "$ref": "#/$defs/identifier" },
        "state": {
          "enum": ["RESERVED", "ATTEMPTED", "SUCCEEDED", "FAILED"]
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "observationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_kind",
        "observation_key",
        "neutral_handoff_id"
      ],
      "properties": {
        "observation_kind": { "enum": ["INTERACTION", "SENDER_SEQUENCE"] },
        "observation_key": { "$ref": "#/$defs/sha256" },
        "neutral_handoff_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "permitState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "permit_store_id",
        "revision",
        "captured_at",
        "records",
        "observations"
      ],
      "properties": {
        "version": { "const": "crosstrace-neutral-permit-state/0.1" },
        "permit_store_id": { "$ref": "#/$defs/identifier" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permitRecord" }
        },
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/observationRecord" }
        }
      }
    }
  }
}
