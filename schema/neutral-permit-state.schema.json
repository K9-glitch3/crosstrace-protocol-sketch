{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/neutral-permit-state.schema.json",
  "title": "CrossTrace representation-neutral local permit state",
  "description": "Development-only local one-attempt state. It deliberately uses neutral handoff identifiers and never receipt-named aliases.",
  "$ref": "#/$defs/permitState",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "permitRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "leaf_neutral_handoff_id",
        "neutral_chain_id",
        "controlling_status_id",
        "replay_scope_id",
        "request_hash",
        "action_nonce",
        "tool_id",
        "state",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "permit_id": { "$ref": "#/$defs/identifier" },
        "leaf_neutral_handoff_id": { "$ref": "#/$defs/sha256" },
        "neutral_chain_id": { "$ref": "#/$defs/sha256" },
        "controlling_status_id": { "$ref": "#/$defs/sha256" },
        "replay_scope_id": { "$ref": "#/$defs/sha256" },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "action_nonce": { "$ref": "#/$defs/identifier" },
        "tool_id": { "$ref": "#/$defs/identifier" },
        "state": {
          "enum": ["RESERVED", "ATTEMPTED", "SUCCEEDED", "FAILED"]
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "observationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_kind",
        "observation_key",
        "neutral_handoff_id"
      ],
      "properties": {
        "observation_kind": { "enum": ["INTERACTION", "SENDER_SEQUENCE"] },
        "observation_key": { "$ref": "#/$defs/sha256" },
        "neutral_handoff_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "permitState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "permit_store_id",
        "revision",
        "captured_at",
        "records",
        "observations"
      ],
      "properties": {
        "version": { "const": "crosstrace-neutral-permit-state/0.1" },
        "permit_store_id": { "$ref": "#/$defs/identifier" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permitRecord" }
        },
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/observationRecord" }
        }
      }
    }
  }
}
