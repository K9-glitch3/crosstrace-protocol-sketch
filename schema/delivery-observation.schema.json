{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/K9-glitch3/crosstrace-protocol-sketch/schema/delivery-observation.schema.json",
  "title": "CrossTrace Sprint 1 delivery observation",
  "oneOf": [
    { "$ref": "#/$defs/localObservation" },
    { "$ref": "#/$defs/auditObservation" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "payloadKind": {
      "enum": [
        "AUTHORITY_STATUS",
        "RECEIPT",
        "SIGNED_ENDPOINT_RECORD",
        "CROSS_REFERENCED_RECORD",
        "PROTOCOL_SIGNAL"
      ]
    },
    "deliveredMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transmission_id",
        "delivery_slot_id",
        "message_id",
        "copy_index",
        "origin_store_id",
        "destination_store_id",
        "sent_at",
        "delivered_at",
        "payload_kind",
        "payload_hash",
        "payload_b64",
        "payload_size_bytes"
      ],
      "properties": {
        "transmission_id": { "$ref": "#/$defs/hash" },
        "delivery_slot_id": { "$ref": "#/$defs/identifier" },
        "message_id": { "$ref": "#/$defs/hash" },
        "copy_index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "origin_store_id": { "$ref": "#/$defs/identifier" },
        "destination_store_id": { "$ref": "#/$defs/identifier" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "delivered_at": { "$ref": "#/$defs/timestamp" },
        "payload_kind": { "$ref": "#/$defs/payloadKind" },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "payload_b64": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "payload_size_bytes": { "type": "integer", "minimum": 2 }
      }
    },
    "permitRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permit_id",
        "leaf_receipt_id",
        "replay_scope",
        "request_hash",
        "action_nonce",
        "tool_id",
        "state",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "permit_id": { "$ref": "#/$defs/identifier" },
        "leaf_receipt_id": { "$ref": "#/$defs/hash" },
        "replay_scope": { "$ref": "#/$defs/hash" },
        "request_hash": { "$ref": "#/$defs/hash" },
        "action_nonce": { "$ref": "#/$defs/identifier" },
        "tool_id": { "$ref": "#/$defs/identifier" },
        "state": {
          "enum": ["RESERVED", "ATTEMPTED", "SUCCEEDED", "FAILED"]
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "permitObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_kind", "observation_key", "receipt_id"],
      "properties": {
        "observation_kind": { "$ref": "#/$defs/identifier" },
        "observation_key": { "$ref": "#/$defs/identifier" },
        "receipt_id": { "$ref": "#/$defs/hash" }
      }
    },
    "permitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permit_store_id", "captured_at", "records", "observations"],
      "properties": {
        "permit_store_id": { "$ref": "#/$defs/identifier" },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/permitRecord" },
          "uniqueItems": true
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/permitObservation" },
          "uniqueItems": true
        }
      }
    },
    "localObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "observation_type",
        "verifier_id",
        "evidence_store_id",
        "permit_store_id",
        "decision_time",
        "delivered_messages",
        "permit_state"
      ],
      "properties": {
        "version": { "const": "crosstrace-delivery/0.1" },
        "observation_type": { "const": "LOCAL" },
        "verifier_id": { "$ref": "#/$defs/identifier" },
        "evidence_store_id": { "$ref": "#/$defs/identifier" },
        "permit_store_id": { "$ref": "#/$defs/identifier" },
        "decision_time": { "$ref": "#/$defs/timestamp" },
        "delivered_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/deliveredMessage" },
          "uniqueItems": true
        },
        "permit_state": { "$ref": "#/$defs/permitState" }
      }
    },
    "auditObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "observation_type",
        "audit_store_id",
        "episode_end",
        "delta_audit_seconds",
        "cutoff",
        "delivered_messages"
      ],
      "properties": {
        "version": { "const": "crosstrace-delivery/0.1" },
        "observation_type": { "const": "AUDIT" },
        "audit_store_id": { "$ref": "#/$defs/identifier" },
        "episode_end": { "$ref": "#/$defs/timestamp" },
        "delta_audit_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "cutoff": { "$ref": "#/$defs/timestamp" },
        "delivered_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/deliveredMessage" },
          "uniqueItems": true
        }
      }
    }
  }
}
