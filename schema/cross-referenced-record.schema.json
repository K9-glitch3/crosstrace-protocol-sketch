{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/cross-referenced-record.schema.json",
  "title": "CrossTrace cross-referenced signed endpoint record",
  "description": "One sender or receiver record in the CR representation. A sender record is byte-for-byte schema-compatible with the SL sender form; a receiver record signs the sender record identifier. Holder-to-role identity, derived identifiers, signature verification, and canonical byte equality are executable validation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "body_id", "body", "attestation"],
  "properties": {
    "record_id": { "$ref": "#/$defs/sha256" },
    "body_id": { "$ref": "#/$defs/sha256" },
    "body": { "$ref": "#/$defs/crossReferencedRecordBody" },
    "attestation": { "$ref": "#/$defs/attestation" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "agent_id", "key_id"],
      "properties": {
        "principal_id": { "$ref": "#/$defs/identifier" },
        "agent_id": { "$ref": "#/$defs/identifier" },
        "key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "paymentV1Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "resources",
        "currency",
        "max_amount_minor",
        "not_before",
        "not_after",
        "redelegations_remaining"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": { "$ref": "#/$defs/timestamp" },
        "redelegations_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "authorityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_principal_id",
        "subject_principal_id",
        "subject_key_id"
      ],
      "properties": {
        "issuer_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_principal_id": { "$ref": "#/$defs/identifier" },
        "subject_key_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "neutralHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "sender",
        "receiver",
        "event_type",
        "sender_sequence",
        "previous_interaction_id",
        "scope",
        "authority_lineage",
        "authority_version",
        "referenced_status_id",
        "created_at",
        "request_hash"
      ],
      "properties": {
        "interaction_id": { "$ref": "#/$defs/identifier" },
        "sender": { "$ref": "#/$defs/party" },
        "receiver": { "$ref": "#/$defs/party" },
        "event_type": { "enum": ["delegation", "action_intent"] },
        "sender_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous_interaction_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "scope": { "$ref": "#/$defs/paymentV1Scope" },
        "authority_lineage": { "$ref": "#/$defs/authorityLineage" },
        "authority_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "referenced_status_id": { "$ref": "#/$defs/sha256" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "request_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "crossReferencedRecordBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_version",
        "record_type",
        "holder",
        "role",
        "handoff",
        "sender_record_id",
        "decision",
        "reason_code",
        "decided_at"
      ],
      "properties": {
        "record_version": { "const": "crosstrace-evidence/0.1" },
        "record_type": { "const": "signed_endpoint_record" },
        "holder": { "$ref": "#/$defs/party" },
        "role": { "enum": ["SENDER", "RECEIVER"] },
        "handoff": { "$ref": "#/$defs/neutralHandoff" },
        "sender_record_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "decision": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["ACCEPT", "REJECT"] }
          ]
        },
        "reason_code": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        },
        "decided_at": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/timestamp" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "SENDER" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "sender_record_id": { "type": "null" },
              "decision": { "type": "null" },
              "reason_code": { "type": "null" },
              "decided_at": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "RECEIVER" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "sender_record_id": { "$ref": "#/$defs/sha256" },
              "decision": { "enum": ["ACCEPT", "REJECT"] },
              "decided_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "ACCEPT" } },
            "required": ["decision"]
          },
          "then": { "properties": { "reason_code": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "decision": { "const": "REJECT" } },
            "required": ["decision"]
          },
          "then": {
            "properties": { "reason_code": { "$ref": "#/$defs/identifier" } }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "body_id", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "body_id": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
