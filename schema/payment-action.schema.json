{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/crosstrace-sketch/payment-action.schema.json",
  "title": "CrossTrace sketch exact payment action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "type",
    "action_nonce",
    "operation",
    "resource",
    "currency",
    "amount_minor"
  ],
  "properties": {
    "protocol_version": { "const": "crosstrace-sketch/0.1" },
    "type": { "const": "payment_action" },
    "action_nonce": { "$ref": "#/$defs/identifier" },
    "operation": { "$ref": "#/$defs/identifier" },
    "resource": { "$ref": "#/$defs/identifier" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    }
  }
}
