{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crosstrace.example/schema/preaward/six-cell-execution.schema.json",
  "title": "CrossTrace Sprint 4 branch execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "version",
    "release_id",
    "claim_level",
    "case_id",
    "cell_id",
    "representation",
    "enforcement",
    "bundle_id",
    "neutral_trace_hash",
    "action_hash",
    "slot_manifest_hash",
    "transport_projection_hash",
    "local_validation",
    "audit_validation",
    "gate",
    "adapter_attempts",
    "engineering_counts"
  ],
  "properties": {
    "execution_id": {"$ref": "#/$defs/hash"},
    "version": {"const": "crosstrace-six-cell/0.1"},
    "release_id": {"const": "crosstrace-six-cell-development-v0.1"},
    "claim_level": {"const": "PREAWARD_DEVELOPMENT_CONFORMANCE"},
    "case_id": {"$ref": "#/$defs/id"},
    "cell_id": {
      "enum": [
        "SL-AUDIT",
        "SL-GATE",
        "CR-AUDIT",
        "CR-GATE",
        "PR-AUDIT",
        "PR-GATE"
      ]
    },
    "representation": {"enum": ["SL", "CR", "PR"]},
    "enforcement": {"enum": ["AUDIT", "GATE"]},
    "bundle_id": {"$ref": "#/$defs/hash"},
    "neutral_trace_hash": {"$ref": "#/$defs/hash"},
    "action_hash": {"$ref": "#/$defs/hash"},
    "slot_manifest_hash": {"$ref": "#/$defs/hash"},
    "transport_projection_hash": {"$ref": "#/$defs/hash"},
    "local_validation": {"$ref": "#/$defs/validation"},
    "audit_validation": {"$ref": "#/$defs/validation"},
    "gate": {"$ref": "#/$defs/gate"},
    "adapter_attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "engineering_counts": {"$ref": "#/$defs/counts"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_reason",
        "chain_status",
        "interaction_ids",
        "issue_codes",
        "policy_view_hashes",
        "validated_handoff_ids"
      ],
      "properties": {
        "chain_reason": {"type": "string", "minLength": 1},
        "chain_status": {"enum": ["COMPLETE", "UNRESOLVED"]},
        "interaction_ids": {"$ref": "#/$defs/stringArray"},
        "issue_codes": {"$ref": "#/$defs/stringArray"},
        "policy_view_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "validated_handoff_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoked",
        "common_input_ids",
        "common_inputs",
        "common_input_forbidden_fields",
        "decisions",
        "transitions",
        "finish_results",
        "permit_reservations",
        "permit_store_mutations"
      ],
      "properties": {
        "invoked": {"type": "boolean"},
        "common_input_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"}
        },
        "common_inputs": {"type": "array", "items": {"type": "object"}},
        "common_input_forbidden_fields": {"type": "array", "maxItems": 0},
        "decisions": {"type": "array", "items": {"type": "object"}},
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition"}
        },
        "finish_results": {"type": "array", "items": {"type": "boolean"}},
        "permit_reservations": {"type": "integer", "minimum": 0},
        "permit_store_mutations": {"type": "integer", "minimum": 0}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permit_id", "reason", "verdict", "version"],
      "properties": {
        "permit_id": {"$ref": "#/$defs/id"},
        "reason": {"type": ["string", "null"]},
        "verdict": {"enum": ["ALLOW", "PAUSE"]},
        "version": {"const": "crosstrace-permit-transition/0.1"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "attempted",
        "committed",
        "operational_failure"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "attempted": {"type": "boolean"},
        "committed": {"type": "boolean"},
        "operational_failure": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_delivered_messages",
        "audit_delivered_messages",
        "local_delivered_payload_bytes",
        "audit_delivered_payload_bytes",
        "adapter_calls",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "runtime_network_calls"
      ],
      "properties": {
        "local_delivered_messages": {"type": "integer", "minimum": 0},
        "audit_delivered_messages": {"type": "integer", "minimum": 0},
        "local_delivered_payload_bytes": {"type": "integer", "minimum": 0},
        "audit_delivered_payload_bytes": {"type": "integer", "minimum": 0},
        "adapter_calls": {"type": "integer", "minimum": 0},
        "model_calls": {"const": 0},
        "input_tokens": {"const": 0},
        "output_tokens": {"const": 0},
        "runtime_network_calls": {"const": 0}
      }
    }
  }
}
